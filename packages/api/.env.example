# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Linq Configuration (sole iMessage provider) - https://docs.linqapp.com
LINQ_API_KEY=your_linq_api_key_here
LINQ_WEBHOOK_SECRET=whsec_your_linq_webhook_signing_secret_here
# Optional; used only by the local webhook simulator to label your Linq line.
LINQ_FROM_NUMBER=+1234567890
# Optional separate secret for short-lived chart media URLs. If omitted,
# LINQ_WEBHOOK_SECRET signs them.
CHART_URL_SIGNING_SECRET=replace_with_a_long_random_secret
# Optional canonical public origin for Linq media downloads. The webhook
# request origin is used when this is omitted.
PINCH_PUBLIC_BASE_URL=https://your-app.vercel.app

# Reply provider. OpenAI is the default; GLM-5.2 is available through Zhipu's
# OpenAI-compatible Chat Completions endpoint.
PINCH_REPLY_PROVIDER=openai
PINCH_REPLY_MODEL=gpt-5.6-sol
PINCH_REPLY_REASONING_EFFORT=medium
# Required when PINCH_REPLY_PROVIDER=groq. Use openai/gpt-oss-120b and low
# reasoning for the free-plan quality test.
GROQ_API_KEY=your_groq_api_key_here
# Required when PINCH_REPLY_PROVIDER=glm.
GLM_API_KEY=your_glm_api_key_here

# OpenAI remains required for production replies, memory, embeddings, and
# voice-note transcription even when Groq handles local text replies.
OPENAI_API_KEY=your_openai_api_key_here
# Optional Pinch-owned memory overrides; these are the defaults.
PINCH_MEMORY_EXTRACTION_MODEL=gpt-5.6-luna
PINCH_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Optional bearer secret for managing real-user memories through /api/memory.
# Test-session identifiers remain available without it.
PINCH_MEMORY_ADMIN_SECRET=replace_with_a_long_random_secret

# Google AI (auxiliary birth and media extraction)
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Exa AI (Web Search)
EXA_API_KEY=your_exa_api_key_here

# Convex (profiles + chat history) - https://convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here

# Mem0 is retired. Keep this only while running the one-time migration script.
MEM0_API_KEY=your_mem0_api_key_here

# Braintrust AI Observability
BRAINTRUST_API_KEY=your_braintrust_api_key_here
BRAINTRUST_PARENT=project_name:pinch-sms-astrologer

# Next.js Configuration
NODE_ENV=development
