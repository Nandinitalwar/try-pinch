# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SendBlue Configuration (iMessage)
SENDBLUE_API_KEY_ID=your_sendblue_api_key_id_here
SENDBLUE_API_SECRET_KEY=your_sendblue_api_secret_key_here
SENDBLUE_FROM_NUMBER=+1234567890

# Blooio Configuration (iMessage) - https://docs.blooio.com
BLOOIO_API_KEY=your_blooio_api_key_here
BLOOIO_FROM_NUMBER=+1234567890
BLOOIO_WEBHOOK_SECRET=your_blooio_webhook_signing_secret_here

# Google AI (Gemini)
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Exa AI (Web Search)
EXA_API_KEY=your_exa_api_key_here

# Convex (profiles + chat history) - https://convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here

# Mem0 (AI user memory) - https://mem0.ai
MEM0_API_KEY=your_mem0_api_key_here

# Braintrust AI Observability
BRAINTRUST_API_KEY=your_braintrust_api_key_here
BRAINTRUST_PARENT=project_name:pinch-sms-astrologer

# Next.js Configuration
NODE_ENV=development